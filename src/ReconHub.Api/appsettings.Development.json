{
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "ReconHub": "Debug"
      }
    }
  },
  "ConnectionStrings": {
    "ReconHub": "Server=127.0.0.1,1433;Database=ReconHub;User Id=sa;Password=<sa-password>;Encrypt=True;TrustServerCertificate=True"
  },
  "Seed": {
    "Enabled": true,
    "WmsApiKey": "<wms-api-key>",
    "ErpApiKey": "<erp-api-key>"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [
          "http://localhost:5080",
          "https://localhost:7080"
        ],
        "ValidIssuer": "dotnet-user-jwts"
      }
    }
  }
}