{
  "openapi": "3.1.1",
  "info": {
    "title": "ReconHub API",
    "description": "Integration monitoring and reconciliation for WMS, ERP and carrier systems.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Service health",
        "description": "Always returns 200; the status field reports the actual health.",
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "post": {
        "tags": [
          "Events"
        ],
        "summary": "Report an integration event",
        "description": "Called by source systems, authenticated with the X-Api-Key header. Returns 201 for a new event and 200 with the original event when the idempotency key was already used by this source system.",
        "operationId": "IngestEvent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestEventResponse"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestEventResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/exceptions": {
      "get": {
        "tags": [
          "Exceptions"
        ],
        "summary": "List reconciliation exceptions",
        "description": "Filter by type, status and detection time range [from, to). Newest first, paged.",
        "operationId": "ListExceptions",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ExceptionType"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ExceptionStatus"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfExceptionDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/exceptions/{id}/resolve": {
      "post": {
        "tags": [
          "Exceptions"
        ],
        "summary": "Resolve an exception",
        "description": "Marks an open exception as resolved with a mandatory note and writes an audit entry.",
        "operationId": "ResolveException",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveExceptionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EventStatus": {
        "enum": [
          "Success",
          "Failed"
        ]
      },
      "ExceptionDto": {
        "required": [
          "id",
          "type",
          "status",
          "detail",
          "transactionId",
          "businessKey",
          "transactionState",
          "flowDefinitionId",
          "flowName",
          "integrationEventId",
          "detectedAt",
          "resolvedAt",
          "resolvedBy",
          "resolutionNote"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/ExceptionType"
          },
          "status": {
            "$ref": "#/components/schemas/ExceptionStatus"
          },
          "detail": {
            "type": "string"
          },
          "transactionId": {
            "type": "string",
            "format": "uuid"
          },
          "businessKey": {
            "type": "string"
          },
          "transactionState": {
            "$ref": "#/components/schemas/TransactionState"
          },
          "flowDefinitionId": {
            "type": "string",
            "format": "uuid"
          },
          "flowName": {
            "type": "string"
          },
          "integrationEventId": {
            "type": "string",
            "format": "uuid"
          },
          "detectedAt": {
            "type": "string",
            "format": "date-time"
          },
          "resolvedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "resolvedBy": {
            "type": [
              "null",
              "string"
            ]
          },
          "resolutionNote": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ExceptionStatus": {
        "enum": [
          "Open",
          "Resolved"
        ]
      },
      "ExceptionType": {
        "enum": [
          "Missing",
          "Failed",
          "Duplicate",
          "Mismatch"
        ]
      },
      "HealthCheckResult": {
        "required": [
          "name",
          "status",
          "description",
          "durationMs"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "durationMs": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status",
          "totalDurationMs",
          "checks"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "totalDurationMs": {
            "type": "number",
            "format": "double"
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HealthCheckResult"
            }
          }
        }
      },
      "HealthStatus": {
        "enum": [
          "Unhealthy",
          "Degraded",
          "Healthy"
        ]
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "IngestEventRequest": {
        "required": [
          "eventType",
          "businessKey",
          "occurredAt",
          "status",
          "idempotencyKey"
        ],
        "type": "object",
        "properties": {
          "eventType": {
            "type": "string"
          },
          "businessKey": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/EventStatus"
          },
          "payload": {
            "$ref": "#/components/schemas/JsonElement"
          },
          "idempotencyKey": {
            "type": "string"
          }
        }
      },
      "IngestEventResponse": {
        "required": [
          "eventId",
          "replayed",
          "transactionIds"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "replayed": {
            "type": "boolean"
          },
          "transactionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "JsonElement": { },
      "PagedResultOfExceptionDto": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExceptionDto"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ResolveExceptionRequest": {
        "required": [
          "note"
        ],
        "type": "object",
        "properties": {
          "note": {
            "type": "string"
          }
        }
      },
      "TransactionState": {
        "enum": [
          "Pending",
          "Completed",
          "Exception"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Events"
    },
    {
      "name": "Exceptions"
    }
  ]
}